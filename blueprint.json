{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Familypedia",
		"description": "Create your own, pricate Wikipedia about your family..",
		"author": "Alex Kirk",
		"categories": [
			"Apps",
			"Genealogy"
		]
	},
	"landingPage": "/familypedia/",
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/akirk/familypedia",
				"ref": "dist/main",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "familypedia"
			}
		}
	]
}
